{
  "name": "denote",
  "private": true,
  "version": "0.12.1",
  "type": "module",
  "workspaces": [
    "packages/plugin-sdk",
    "plugins/*"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run prepare:pdf-assets && vite",
    "dev:desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:plugin": "tsx scripts/dev-plugin.ts",
    "build": "npm run prepare:pdf-assets && tsc --noEmit && vite build",
    "prepare:pdf-assets": "node scripts/pdfjs-assets.mjs",
    "build:website": "node scripts/build-website.mjs",
    "build:plugins": "tsx scripts/build-plugins.ts",
    "build:plugin": "tsx scripts/build-plugins.ts --plugin",
    "prepare:bundled-tools": "node scripts/bundled-tools.mjs",
    "verify:bundled-tools": "node scripts/verify-bundled-tools.mjs",
    "test:bundled-tools": "node --test scripts/bundled-tools.node.mjs",
    "test:speech-model": "tsx scripts/test-speech-model.ts",
    "prepare:speech-helper": "node scripts/prepare-speech-helper.mjs",
    "benchmark:editor": "tsc --noEmit -p tsconfig.benchmarks.json && npm run build && playwright test",
    "create:plugin": "tsx scripts/create-plugin.ts",
    "package:plugin": "tsx scripts/package-plugin.ts",
    "package:plugins": "npm run build:plugins && tsx scripts/package-plugins.ts",
    "pin:plugin": "tsx scripts/pin-plugin.ts",
    "preview": "vite preview",
    "test": "vitest run && npm run test:website && npm run test:bundled-tools",
    "test:website": "node --test website/*.node.mjs",
    "test:watch": "vitest",
    "check:plugin-archives": "node scripts/check-plugin-archives.mjs",
    "check:plugins": "npm run check:plugin-archives && tsx scripts/validate-plugins.ts && tsc --noEmit -p plugins/tsconfig.json && npm run build:plugins && tsx scripts/validate-plugins.ts --artifacts && tsx scripts/package-plugins.ts --check",
    "check:plugin-downloads": "node scripts/plugin-downloads.mjs",
    "check": "npm run test && npm run check:plugins && npm run build && cargo test --manifest-path src-tauri/Cargo.toml",
    "release": "node scripts/release.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lexical/hashtag": "0.52.0",
    "@lexical/react": "0.52.0",
    "@lezer/highlight": "^1.2.5",
    "@mdxeditor/editor": "^4.3.3",
    "@mdxeditor/gurx": "^1.2.4",
    "@pierre/diffs": "^1.6.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-opener": "^2",
    "codemirror-lang-elixir": "^4.0.1",
    "codemirror-lang-hcl": "^0.2.0",
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "lucide-react": "^1.57.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-extension-mdx-jsx": "^3.0.2",
    "micromark-extension-mdx-md": "^2.0.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zbsearch": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.11.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "acorn": "^8.19.0",
    "decode-named-character-reference": "^1.3.0",
    "jsdom": "^30.1.3",
    "pako": "3.0.2",
    "tar": "^7.5.22",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@lexical/hashtag": "$@lexical/hashtag",
    "@lexical/react": "$@lexical/react",
    "@mdxeditor/editor": {
      "@lexical/clipboard": "$@lexical/react",
      "@lexical/extension": "$@lexical/react",
      "@lexical/history": "$@lexical/react",
      "@lexical/link": "$@lexical/react",
      "@lexical/list": "$@lexical/react",
      "@lexical/markdown": "$@lexical/react",
      "@lexical/plain-text": "$@lexical/react",
      "@lexical/react": "$@lexical/react",
      "@lexical/rich-text": "$@lexical/react",
      "@lexical/selection": "$@lexical/react",
      "@lexical/utils": "$@lexical/react",
      "lexical": "$@lexical/react"
    },
    "dompurify": "3.4.17",
    "js-yaml": "4.3.2",
    "rolldown": "1.2.15",
    "source-map-js": "1.2.2",
    "undici": "8.12.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}

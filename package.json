{
  "name": "denote",
  "private": true,
  "version": "0.14.3",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run prepare:pdf-assets && vite",
    "dev:desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "npm run prepare:pdf-assets && tsc --noEmit && vite build",
    "prepare:pdf-assets": "node scripts/pdfjs-assets.mjs",
    "prepare:bundled-tools": "node scripts/bundled-tools.mjs",
    "verify:bundled-tools": "node scripts/verify-bundled-tools.mjs",
    "test:bundled-tools": "node --test scripts/bundled-tools.node.mjs",
    "test:speech-model": "tsx scripts/test-speech-model.ts",
    "prepare:speech-helper": "node scripts/prepare-speech-helper.mjs",
    "benchmark:editor": "tsc --noEmit -p tsconfig.benchmarks.json && npm run build && playwright test",
    "preview": "vite preview",
    "test": "vitest run && npm run test:bundled-tools",
    "test:watch": "vitest",
    "check:plugins": "tsc --noEmit -p tsconfig.scripts.json && tsx scripts/plugin-catalog.ts",
    "check:plugin-downloads": "node scripts/plugin-downloads.mjs",
    "fetch:plugins": "node scripts/plugin-downloads.mjs --stage",
    "update:plugin": "tsx scripts/update-plugin.ts",
    "check:secrets": "gitleaks git --log-opts=HEAD --redact=100 --no-banner",
    "check": "npm run test && npm run check:plugins && npm run build && cargo test --manifest-path src-tauri/Cargo.toml",
    "release": "node scripts/release.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@denote/plugin-sdk": "github:denote-io/denote-plugin-sdk#v0.1.1",
    "@lexical/hashtag": "0.53.0",
    "@lexical/react": "0.53.0",
    "@lezer/highlight": "^1.2.5",
    "@mdxeditor/editor": "^4.5.0",
    "@mdxeditor/gurx": "^1.2.4",
    "@pierre/diffs": "^1.6.4",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-opener": "^2",
    "codemirror-lang-elixir": "^4.0.1",
    "codemirror-lang-hcl": "^0.2.0",
    "diff": "9.0.0",
    "dompurify": "3.4.18",
    "ghostty-web": "0.4.0",
    "lucide-react": "^1.75.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-markdown": "^2.2.3",
    "micromark-extension-mdx-jsx": "^3.0.2",
    "micromark-extension-mdx-md": "^2.0.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zbsearch": "^4.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "2.11.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.3.0",
    "acorn": "^8.19.0",
    "decode-named-character-reference": "^1.3.0",
    "jsdom": "^31.0.0",
    "pele": "1.13.0",
    "tar": "^7.5.23",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.1",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@lexical/hashtag": "$@lexical/hashtag",
    "@lexical/react": "$@lexical/react",
    "@mdxeditor/editor": {
      "@lexical/clipboard": "$@lexical/react",
      "@lexical/extension": "$@lexical/react",
      "@lexical/history": "$@lexical/react",
      "@lexical/link": "$@lexical/react",
      "@lexical/list": "$@lexical/react",
      "@lexical/markdown": "$@lexical/react",
      "@lexical/plain-text": "$@lexical/react",
      "@lexical/react": "$@lexical/react",
      "@lexical/rich-text": "$@lexical/react",
      "@lexical/selection": "$@lexical/react",
      "@lexical/utils": "$@lexical/react",
      "lexical": "$@lexical/react"
    },
    "dompurify": "3.4.18",
    "js-yaml": "4.3.2",
    "source-map-js": "1.2.2",
    "undici": "8.12.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}

{
  "name": "denote",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "workspaces": [
    "packages/plugin-sdk",
    "packages/plugins/*"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:plugins": "tsx scripts/build-plugins.ts",
    "create:plugin": "tsx scripts/create-plugin.ts",
    "package:plugins": "npm run build:plugins && tsx scripts/package-plugins.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:plugins": "tsx scripts/validate-plugins.ts && tsc --noEmit -p packages/plugins/tsconfig.json && npm run build:plugins && tsx scripts/validate-plugins.ts --artifacts && tsx scripts/package-plugins.ts --check",
    "check": "npm run test && npm run check:plugins && npm run build && cargo test --manifest-path src-tauri/Cargo.toml",
    "release": "node scripts/release.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lexical/hashtag": "0.49.0",
    "@lexical/react": "0.49.0",
    "@lezer/highlight": "^1.2.3",
    "@mdxeditor/editor": "^4.2.3",
    "@mdxeditor/gurx": "^1.2.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "codemirror-lang-elixir": "^4.0.1",
    "lucide-react": "^1.37.0",
    "mdast-util-from-markdown": "^2.0.3",
    "micromark-extension-mdx-jsx": "^3.0.2",
    "micromark-extension-mdx-md": "^2.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zbsearch": "^4.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.1",
    "decode-named-character-reference": "^1.3.0",
    "jsdom": "^30.0.1",
    "tar": "^7.5.22",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@lexical/hashtag": "$@lexical/hashtag",
    "@lexical/react": "$@lexical/react",
    "@mdxeditor/editor": {
      "@lexical/clipboard": "$@lexical/react",
      "@lexical/extension": "$@lexical/react",
      "@lexical/history": "$@lexical/react",
      "@lexical/link": "$@lexical/react",
      "@lexical/list": "$@lexical/react",
      "@lexical/markdown": "$@lexical/react",
      "@lexical/plain-text": "$@lexical/react",
      "@lexical/react": "$@lexical/react",
      "@lexical/rich-text": "$@lexical/react",
      "@lexical/selection": "$@lexical/react",
      "@lexical/utils": "$@lexical/react",
      "lexical": "$@lexical/react"
    }
  }
}

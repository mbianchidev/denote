{
  "schemaVersion": 1,
  "id": "denote.mermaid",
  "name": "Mermaid diagrams",
  "version": "0.1.0",
  "description": "Render a safe local subset of Mermaid fenced blocks in Markdown rich view.",
  "publisher": {
    "name": "Denote",
    "url": "https://github.com/mbianchidev/denote"
  },
  "license": "MIT AND (MPL-2.0 OR Apache-2.0)",
  "repository": "https://github.com/mbianchidev/denote",
  "icon": "icon.svg",
  "category": "diagrams-visualization",
  "compatibility": {
    "apiVersion": 1,
    "minimumDenoteVersion": "0.3.0"
  },
  "permissions": [
    {
      "capability": "diagram-renderer"
    }
  ],
  "entrypoint": "dist/index.js",
  "diagramRenderer": {
    "entrypoint": "dist/renderer.js"
  },
  "legal": [
    "legal/THIRD_PARTY_NOTICES.md",
    "legal/mermaid-MIT.txt",
    "legal/dompurify-APACHE-2.0.txt"
  ],

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Denote",
  "version": "0.3.2",
  "identifier": "dev.mbianchi.denote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Denote",
        "width": 1440,
        "height": 900,
        "minWidth": 920,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' data: blob: 'wasm-unsafe-eval' 'sha256-YL/+v3Ibpu5bxy8Rdum29twfQ7wFcwuXVAxoIpFJQ6A='; worker-src 'self'; frame-src data:; img-src 'self' asset: http: https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/tools": "tools"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "denote"
        ]
      }
    },
    "updater": {
      "endpoints": [],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
